# CRM IA — app do ambiente de um cliente (desenvolvimento avulso).
# Em produção nada disto vem de arquivo: o provisionador injeta as variáveis
# no container de cada cliente (ver infra/tenant/docker-compose.tenant.tmpl).

APP_ENV=development
PORT=8080

# Endereço público do ambiente e prefixo no domínio (vazio = raiz).
APP_URL=http://localhost:8080
BASE_PATH=
TENANT_SLUG=dev
TENANT_NOME=Minha Empresa (dev)
TEMA_COR_PRIMARIA=#6d5df6
TEMA_LOGO_URL=

# PostgreSQL e Redis do ambiente
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crmia_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Segredos (gere com: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-forte
CHAVE_CRIPTO=
TOKEN_INTERNO=
PAINEL_URL=

# Licença: teto de usuários ativos (0 = sem teto)
LICENCA_USUARIOS_MAX=0

# Administrador inicial (criado só com o banco vazio)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_SENHA=troque-esta-senha

# E-mail padrão do ambiente (o cliente pode escolher Mandrill/Maileroo na tela)
MANDRILL_API_KEY=
FROM_EMAIL=nao-responda@exemplo.com.br
FROM_NAME=Minha Empresa
EMAIL_DEV=dev@exemplo.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook de entrada do Mandrill (respostas na Caixa de entrada)
MANDRILL_WEBHOOK_KEY=
MANDRILL_WEBHOOK_URL=
