# Copie para .env (desenvolvimento local) ou .env.production (Linux/producao).
# Em producao o conteudo fica no secret ENV_PRODUCTION do GitHub.

# Ambiente: production | homologation | dev
env=dev

# HTTP
port_server=9000
app_url=http://localhost:9000

# PostgreSQL (em producao o banco fica em outro servidor)
host=localhost
port_banco=5432
user=fixcrm
password=fixcrm
dbname=fixcrm

# Autenticacao (gere um segredo forte: openssl rand -hex 32)
jwt_secret=troque-por-um-segredo-forte

# Administrador inicial (criado apenas quando o banco esta vazio)
admin_email=admin@fixpay.com.br
admin_password=troque-esta-senha

# Mandrill (envio de e-mails transacionais)
mandrill=chave-do-mandrill
from=nao-responda@fixpay.com.br
# Fora de producao os e-mails sao redirecionados para este endereco:
email_dev=dev@fixpay.com.br
