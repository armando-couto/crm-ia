#!/bin/sh
# Docker falso para os testes: registra cada chamada em $DOCKER_FAKE_LOG e
# responde o mínimo que o provisionador espera.
echo "$*" >> "${DOCKER_FAKE_LOG:-/dev/null}"
case "$1" in
  inspect)
    nome="$2"
    case "$nome" in
      *-suspenso) [ -n "$DOCKER_FAKE_SUSPENSO" ] && echo '[{"State":{"Status":"running"},"Config":{"Image":"x","Labels":{}}}]' && exit 0; exit 1 ;;
      *-app) echo '[{"State":{"Status":"running","Health":{"Status":"healthy"}},"Config":{"Image":"crmia/app:1.0.0","Labels":{"crmia.versao":"1.0.0"}}}]'; exit 0 ;;
      *-db) echo '[{"State":{"Status":"running","Health":{"Status":"healthy"}},"Config":{"Image":"postgres:16-alpine","Labels":{}}}]'; exit 0 ;;
    esac
    exit 1 ;;
  image)
    # image inspect → existe; image ls → tags
    [ "$2" = "ls" ] && printf '1.0.0\nlatest\n' && exit 0
    exit 0 ;;
  ps) printf 'ci-%s-db\trunning\tUp 1 minute\tpostgres:16-alpine\nci-%s-app\trunning\tUp 1 minute\tcrmia/app:1.0.0\n' "$DOCKER_FAKE_SLUG" "$DOCKER_FAKE_SLUG"; exit 0 ;;
  exec) echo "dump-falso"; exit 0 ;;
  *) exit 0 ;;
esac
