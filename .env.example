# =============================================================================
# CRM IA — configuração da plataforma
# Copie para .env (ou rode `make env`, que sorteia os segredos) e preencha o
# que o script não adivinha: domínio, e-mail do Let's Encrypt e credenciais.
# =============================================================================

# -- Domínio e TLS ------------------------------------------------------------
# Domínio público da plataforma (o DNS aponta para o nó do Traefik). Em
# `make dev` isto é sobreposto por crmia.localhost. Valor de partida — troque.
DOMAIN=crmia.com.br
SITE_URL=/
ACME_EMAIL=ti@crmia.com.br
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
APP_ENV=production
NOME_PRODUTO="CRM IA"

# -- PostgreSQL da plataforma (banco do painel) -------------------------------
# No Swarm (stack-portainer.yml) o banco vem junto como serviço `postgres`.
# DEIXE OS TRÊS VAZIOS para usar esse banco (postgres:5432, sem TLS).
# Para um servidor externo, preencha os três.
PGHOST=
PGPORT=
PGSSLMODE=
PGADMIN_USER=postgres
PGADMIN_PASSWORD=
PAINEL_DB_NAME=crmia_painel
PAINEL_DB_USER=crmia_painel
PAINEL_DB_PASSWORD=

# -- Painel administrativo ----------------------------------------------------
PAINEL_SESSION_KEY=
PAINEL_CSRF_KEY=
PAINEL_ADMIN_EMAIL=admin@crmia.com.br
PAINEL_ADMIN_SENHA=
# Dias de tolerância depois do vencimento antes de suspender o ambiente.
DIAS_ATRASO_SUSPENSAO=10

# -- Cobrança recorrente das licenças (credenciais da PRÓPRIA CRM IA) ---------
# O painel cobra cada licença por assinatura mensal no cartão. O cliente
# cadastra o cartão numa página com a marca do CRM IA e nunca vê o
# processador. Sem o token, só a cobrança manual funciona.
FIXPAY_TOKEN_API=
FIXPAY_APIS_URL=https://apis.fixpay.com.br
FIXPAY_SIGN_URL=https://signpayments.fixpay.com.br
# Id do grupo do estabelecimento no serviço de recorrência (exigido pelo
# checkout por integração e pelo cancelamento).
FIXPAY_SIGN_GRUPO_ID=
# "true" simula tudo: assinaturas de mentira, cartão 4111… aprova, …0002 recusa.
FIXPAY_SIMULADO=false

# -- Provisionador ------------------------------------------------------------
PROVISIONER_TOKEN=
# Imagens dos ambientes dos clientes. A tag é a "versão" gerida no painel.
TENANT_IMAGE_APP=crmia/app
TENANT_IMAGE_DB=postgres:16-alpine
TENANT_IMAGE_REDIS=redis:7-alpine
TENANT_IMAGE_SUSPENSO=crmia/suspenso:latest
TENANT_VERSAO_PADRAO=latest
# Credencial do registro (quando as imagens são privadas, ex.: GHCR).
REGISTRY_USER=
REGISTRY_TOKEN=
TENANT_CPU_LIMIT=1.0
TENANT_MEM_LIMIT=768m
TENANT_DB_MEM_LIMIT=512m
TENANT_REDIS_MEM_LIMIT=128m

# -- E-mail transacional da plataforma (Mandrill) -----------------------------
# Avisos do painel (link de cadastro do cartão) e padrão inicial dos
# ambientes. Sem a chave o envio é simulado (só log). Cada cliente escolhe o
# próprio provedor (Mandrill ou Maileroo) dentro do CRM.
MANDRILL_API_KEY=
MANDRILL_FROM_EMAIL=nao-responda@crmia.com.br
MANDRILL_FROM_NOME="CRM IA"

# -- Comercial (landing e páginas públicas) -----------------------------------
EMAIL_COMERCIAL=contato@crmia.com.br
WHATSAPP_COMERCIAL=

# Portas do host (mude se 80/443 já estiverem ocupadas por outro projeto)
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASH_PORT=8190
PROVISIONER_PORT=7998
